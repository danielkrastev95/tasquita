# ── Base de datos (Neon) ─────────────────────────────────────────────────────
# Local: usa SIEMPRE la rama "dev" de Neon, nunca la de producción.
DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── Autenticación (Better Auth) ──────────────────────────────────────────────
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
BETTER_AUTH_URL="http://localhost:3000"

# ── Cloudinary (subida de fotos desde el panel) ──────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="tu-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="tu-upload-preset"

# ── URL pública (SEO, sitemap, Open Graph). En Vercel se detecta sola. ──────
# NEXT_PUBLIC_SITE_URL="https://tasquita.vercel.app"
